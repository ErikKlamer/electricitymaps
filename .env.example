# Copy to .env and fill in. All settings are optional except the API key (or AWS access to SSM).

# Electricity Maps API key. When empty, the key is read from SSM Parameter Store.
EMAPS_API_KEY=

# Where to store the data: a local folder or an S3 location.
EMAPS_STORAGE_URI=data
# EMAPS_STORAGE_URI=s3://emaps-etl-<account_id>-eu-central-1

# AWS profile for S3 and SSM access, e.g. a profile that assumes the writer role.
# EMAPS_AWS_PROFILE=emaps-writer
